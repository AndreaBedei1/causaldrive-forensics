digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e03" [label="TRACK_APPEARED\nC -> track_002\nt=0.00", fillcolor="#bfdbfe"];
  "C:e04" [label="CLOSING_START\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=0.00", fillcolor="#bfdbfe"];
  "C:e06" [label="PREDICTED_PATH_CONFLICT_START\nC -> track_002\nt=0.45", fillcolor="#bfdbfe"];
  "C:e07" [label="PREDICTED_PATH_CONFLICT_END\nC -> track_002\nt=1.65", fillcolor="#bfdbfe"];
  "C:e08" [label="STRONG_THROTTLE_START\nC\nt=1.65", fillcolor="#fde68a"];
  "C:e09" [label="STRONG_THROTTLE_END\nC\nt=2.10", fillcolor="#fde68a"];
  "C:e10" [label="CRITICAL_TTC_START\nC -> track_002\nt=2.25", fillcolor="#bfdbfe"];
  "C:e11" [label="CRITICAL_TTC_START\nC -> track_001\nt=2.45", fillcolor="#bfdbfe"];
  "C:e12" [label="CRITICAL_TTC_END\nC -> track_002\nt=2.95", fillcolor="#bfdbfe"];
  "C:e13" [label="PREDICTED_PATH_CONFLICT_START\nC -> track_002\nt=3.00", fillcolor="#bfdbfe"];
  "C:e14" [label="PREDICTED_PATH_CONFLICT_END\nC -> track_002\nt=3.35", fillcolor="#bfdbfe"];
  "C:e15" [label="TRACK_LOST\nC -> track_002\nt=4.00", fillcolor="#bfdbfe"];
  "C:e16" [label="CRITICAL_TTC_END\nC -> track_001\nt=4.50", fillcolor="#bfdbfe"];
  "C:e17" [label="CLOSING_END\nC -> track_001\nt=4.50", fillcolor="#bfdbfe"];
  "C:e18" [label="TRACK_LOST\nC -> track_001\nt=4.50", fillcolor="#bfdbfe"];
  {rank=same; "C:e01"; "C:e02"; "C:e03"; "C:e04"; "C:e05";}
  {rank=same; "C:e07"; "C:e08";}
  {rank=same; "C:e16"; "C:e17"; "C:e18";}
  "C:e01" -> "C:e06" [label="PRECEDES"];
  "C:e02" -> "C:e06" [label="PRECEDES"];
  "C:e03" -> "C:e06" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e09" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
  "C:e10" -> "C:e11" [label="PRECEDES"];
  "C:e11" -> "C:e12" [label="PRECEDES"];
  "C:e12" -> "C:e13" [label="PRECEDES"];

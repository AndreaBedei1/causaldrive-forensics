digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED_FRONT\nC -> track_001\nt=0.05", fillcolor="#bfdbfe"];
  "C:e03" [label="CLOSING_START\nC -> track_001\nt=0.05", fillcolor="#bfdbfe"];
  "C:e04" [label="TRACK_APPEARED_LEFT\nC -> track_002\nt=0.35", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=0.35", fillcolor="#bfdbfe"];
  "C:e06" [label="CRITICAL_TTC_START\nC -> track_001\nt=2.85", fillcolor="#bfdbfe"];
  "C:e07" [label="COLLISION\nC\nt=4.75", fillcolor="#fca5a5"];
  "C:e08" [label="CLOSING_END\nC -> track_002\nt=4.80", fillcolor="#bfdbfe"];
  "C:e09" [label="BRAKE_START\nC\nt=4.80", fillcolor="#fde68a"];
  "C:e10" [label="CRITICAL_TTC_END\nC -> track_001\nt=4.95", fillcolor="#bfdbfe"];
  "C:e11" [label="CLOSING_END\nC -> track_001\nt=4.95", fillcolor="#bfdbfe"];
  "C:e12" [label="MOVING_END\nC\nt=5.05", fillcolor="#e5e7eb"];
  "C:e13" [label="STOP_START\nC\nt=5.05", fillcolor="#e5e7eb"];
  {rank=same; "C:e02"; "C:e03";}
  {rank=same; "C:e04"; "C:e05";}
  {rank=same; "C:e08"; "C:e09";}
  {rank=same; "C:e10"; "C:e11";}
  {rank=same; "C:e12"; "C:e13";}
  "C:e01" -> "C:e02" [label="PRECEDES"];
  "C:e01" -> "C:e03" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="PRECEDES"];
  "C:e02" -> "C:e05" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e03" -> "C:e05" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e09" [label="PRECEDES"];
  "C:e08" -> "C:e10" [label="PRECEDES"];
  "C:e08" -> "C:e11" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
  "C:e09" -> "C:e11" [label="PRECEDES"];
  "C:e10" -> "C:e12" [label="PRECEDES"];
  "C:e10" -> "C:e13" [label="PRECEDES"];
  "C:e11" -> "C:e12" [label="PRECEDES"];
  "C:e11" -> "C:e13" [label="PRECEDES"];
  "C:e02" -> "C:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

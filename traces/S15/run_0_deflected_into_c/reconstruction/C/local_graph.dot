digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e03" [label="TRACK_APPEARED\nC -> track_002\nt=0.00", fillcolor="#bfdbfe"];
  "C:e04" [label="CLOSING_START\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=0.00", fillcolor="#bfdbfe"];
  "C:e06" [label="STRONG_THROTTLE_START\nC\nt=1.65", fillcolor="#fde68a"];
  "C:e07" [label="STRONG_THROTTLE_END\nC\nt=2.10", fillcolor="#fde68a"];
  "C:e08" [label="CRITICAL_TTC_START\nC -> track_002\nt=2.25", fillcolor="#bfdbfe"];
  "C:e09" [label="CRITICAL_TTC_START\nC -> track_001\nt=2.50", fillcolor="#bfdbfe"];
  "C:e10" [label="CRITICAL_TTC_END\nC -> track_002\nt=3.15", fillcolor="#bfdbfe"];
  "C:e11" [label="TRACK_LOST\nC -> track_002\nt=4.45", fillcolor="#bfdbfe"];
  "C:e12" [label="COLLISION\nC\nt=4.75", fillcolor="#fca5a5"];
  "C:e13" [label="STRONG_THROTTLE_START\nC\nt=4.75", fillcolor="#fde68a"];
  "C:e14" [label="STRONG_THROTTLE_END\nC\nt=4.80", fillcolor="#fde68a"];
  "C:e15" [label="BRAKE_START\nC\nt=4.80", fillcolor="#fde68a"];
  "C:e16" [label="HARD_BRAKE_START\nC\nt=4.80", fillcolor="#fde68a"];
  "C:e17" [label="EGO_PATH_ENTRY\nC -> track_001\nt=5.00", fillcolor="#bfdbfe"];
  "C:e18" [label="CRITICAL_TTC_END\nC -> track_001\nt=5.05", fillcolor="#bfdbfe"];
  "C:e19" [label="CLOSING_END\nC -> track_001\nt=5.05", fillcolor="#bfdbfe"];
  "C:e20" [label="MOVING_END\nC\nt=5.05", fillcolor="#e5e7eb"];
  "C:e21" [label="STOP_START\nC\nt=5.05", fillcolor="#e5e7eb"];
  {rank=same; "C:e01"; "C:e02"; "C:e03"; "C:e04"; "C:e05";}
  {rank=same; "C:e12"; "C:e13";}
  {rank=same; "C:e14"; "C:e15"; "C:e16";}
  {rank=same; "C:e18"; "C:e19"; "C:e20"; "C:e21";}
  "C:e01" -> "C:e06" [label="PRECEDES"];
  "C:e02" -> "C:e06" [label="PRECEDES"];
  "C:e03" -> "C:e06" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
  "C:e10" -> "C:e11" [label="PRECEDES"];
  "C:e11" -> "C:e12" [label="PRECEDES"];
  "C:e11" -> "C:e13" [label="PRECEDES"];
  "C:e12" -> "C:e14" [label="PRECEDES"];
  "C:e12" -> "C:e15" [label="PRECEDES"];
  "C:e12" -> "C:e16" [label="PRECEDES"];
  "C:e13" -> "C:e14" [label="PRECEDES"];
  "C:e13" -> "C:e15" [label="PRECEDES"];
  "C:e13" -> "C:e16" [label="PRECEDES"];
  "C:e14" -> "C:e17" [label="PRECEDES"];
  "C:e15" -> "C:e17" [label="PRECEDES"];
  "C:e16" -> "C:e17" [label="PRECEDES"];
  "C:e17" -> "C:e18" [label="PRECEDES"];
  "C:e17" -> "C:e19" [label="PRECEDES"];
  "C:e17" -> "C:e20" [label="PRECEDES"];
  "C:e17" -> "C:e21" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e17" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e18" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e19" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED_LEFT\nC -> track_001\nt=0.40", fillcolor="#bfdbfe"];
  "C:e03" [label="CLOSING_START\nC -> track_001\nt=0.40", fillcolor="#bfdbfe"];
  "C:e04" [label="TRACK_APPEARED_FRONT\nC -> track_002\nt=1.25", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=1.25", fillcolor="#bfdbfe"];
  "C:e06" [label="TRACK_LOST\nC -> track_001\nt=2.25", fillcolor="#bfdbfe"];
  "C:e07" [label="STOP_SIGN_DETECTED_START\nC -> sign-0\nt=2.80", fillcolor="#bfdbfe"];
  "C:e08" [label="STOP_SIGN_DETECTED_END\nC -> sign-0\nt=2.80", fillcolor="#bfdbfe"];
  "C:e09" [label="TRACK_APPEARED_LEFT\nC -> track_003\nt=3.15", fillcolor="#bfdbfe"];
  "C:e10" [label="CLOSING_START\nC -> track_003\nt=3.90", fillcolor="#bfdbfe"];
  "C:e11" [label="EGO_PATH_ENTRY\nC -> track_002\nt=5.20", fillcolor="#bfdbfe"];
  {rank=same; "C:e02"; "C:e03";}
  {rank=same; "C:e04"; "C:e05";}
  {rank=same; "C:e07"; "C:e08";}
  "C:e01" -> "C:e02" [label="PRECEDES"];
  "C:e01" -> "C:e03" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="PRECEDES"];
  "C:e02" -> "C:e05" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e03" -> "C:e05" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e09" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
  "C:e10" -> "C:e11" [label="PRECEDES"];
  "C:e02" -> "C:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e09" -> "C:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="BRAKE_START\nB\nt=3.15", fillcolor="#fde68a"];
  "B:e03" [label="BRAKE_END\nB\nt=3.60", fillcolor="#fde68a"];
  "B:e04" [label="COLLISION\nB\nt=4.25", fillcolor="#fca5a5"];
  "B:e05" [label="BRAKE_START\nB\nt=4.25", fillcolor="#fde68a"];
  "B:e06" [label="MOVING_END\nB\nt=5.00", fillcolor="#e5e7eb"];
  "B:e07" [label="STOP_START\nB\nt=5.00", fillcolor="#e5e7eb"];
  {rank=same; "B:e04"; "B:e05";}
  {rank=same; "B:e06"; "B:e07";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e06" [label="PRECEDES"];
  "B:e04" -> "B:e07" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e07" [label="PRECEDES"];
}

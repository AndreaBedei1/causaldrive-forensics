digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="BRAKE_EPISODE\nB\nstart=3.15\nduration=0.45s\npeak=0.73", fillcolor="#fde68a"];
  "B:e02" [label="BRAKE_EPISODE\nB\nstart=4.25\nduration=10.90s\npeak=1.00", fillcolor="#fde68a"];
  "B:e03" [label="COLLISION\nB\nt=4.25", fillcolor="#fca5a5"];
  "B:e04" [label="FULL_STOP\nB\nt=5.00", fillcolor="#e5e7eb"];
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
}

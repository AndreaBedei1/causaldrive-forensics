digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="THROTTLE_START\nA\nt=0.00", fillcolor="#fde68a"];
  "A:e03" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=0.15", fillcolor="#bfdbfe"];
  "A:e04" [label="CLOSING_START\nA -> track_001\nt=0.15", fillcolor="#bfdbfe"];
  "A:e05" [label="CRITICAL_TTC_START\nA -> track_001\nt=1.80", fillcolor="#bfdbfe"];
  "A:e06" [label="CUT_IN_FROM_LEFT_START\nA -> track_001\nt=2.10", fillcolor="#bfdbfe"];
  "A:e07" [label="EGO_PATH_ENTRY\nA -> track_001\nt=3.25", fillcolor="#bfdbfe"];
  "A:e08" [label="THROTTLE_END\nA\nt=3.85", fillcolor="#fde68a"];
  "A:e09" [label="BRAKE_START\nA\nt=3.85", fillcolor="#fde68a"];
  "A:e10" [label="COLLISION\nA\nt=4.65", fillcolor="#fca5a5"];
  "A:e11" [label="CUT_IN_FROM_LEFT_END\nA -> track_001\nt=4.65", fillcolor="#bfdbfe"];
  "A:e12" [label="CLOSING_END\nA -> track_001\nt=4.65", fillcolor="#bfdbfe"];
  "A:e13" [label="CRITICAL_TTC_END\nA -> track_001\nt=5.00", fillcolor="#bfdbfe"];
  "A:e14" [label="MOVING_END\nA\nt=5.05", fillcolor="#e5e7eb"];
  "A:e15" [label="STOP_START\nA\nt=5.05", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02";}
  {rank=same; "A:e03"; "A:e04";}
  {rank=same; "A:e08"; "A:e09";}
  {rank=same; "A:e10"; "A:e11"; "A:e12";}
  {rank=same; "A:e14"; "A:e15";}
  "A:e01" -> "A:e03" [label="PRECEDES"];
  "A:e01" -> "A:e04" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];

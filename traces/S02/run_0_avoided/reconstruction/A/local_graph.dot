digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e03" [label="CLOSING_START\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e04" [label="CUT_IN_FROM_LEFT_START\nA -> track_001\nt=2.35", fillcolor="#bfdbfe"];
  "A:e05" [label="BRAKE_START\nA\nt=2.85", fillcolor="#fde68a"];
  "A:e06" [label="EGO_PATH_ENTRY\nA -> track_001\nt=3.25", fillcolor="#bfdbfe"];
  "A:e07" [label="CLOSING_END\nA -> track_001\nt=4.05", fillcolor="#bfdbfe"];
  "A:e08" [label="BRAKE_END\nA\nt=4.10", fillcolor="#fde68a"];
  "A:e09" [label="CUT_IN_FROM_LEFT_END\nA -> track_001\nt=5.30", fillcolor="#bfdbfe"];
  {rank=same; "A:e01"; "A:e02"; "A:e03";}
  "A:e01" -> "A:e04" [label="PRECEDES"];
  "A:e02" -> "A:e04" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e07" -> "A:e08" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

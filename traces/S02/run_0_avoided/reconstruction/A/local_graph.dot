digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TRACK_APPEARED\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e03" [label="CLOSING_START\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e04" [label="STRONG_THROTTLE_START\nA\nt=1.15", fillcolor="#fde68a"];
  "A:e05" [label="STRONG_THROTTLE_END\nA\nt=1.35", fillcolor="#fde68a"];
  "A:e06" [label="PREDICTED_PATH_CONFLICT_START\nA -> track_001\nt=1.90", fillcolor="#bfdbfe"];
  "A:e07" [label="CUT_IN_FROM_LEFT_START\nA -> track_001\nt=2.35", fillcolor="#bfdbfe"];
  "A:e08" [label="CRITICAL_TTC_START\nA -> track_001\nt=2.80", fillcolor="#bfdbfe"];
  "A:e09" [label="BRAKE_START\nA\nt=2.85", fillcolor="#fde68a"];
  "A:e10" [label="HARD_BRAKE_START\nA\nt=2.85", fillcolor="#fde68a"];
  "A:e11" [label="CRITICAL_TTC_END\nA -> track_001\nt=3.10", fillcolor="#bfdbfe"];
  "A:e12" [label="EGO_PATH_ENTRY\nA -> track_001\nt=3.25", fillcolor="#bfdbfe"];
  "A:e13" [label="PREDICTED_PATH_CONFLICT_END\nA -> track_001\nt=3.65", fillcolor="#bfdbfe"];
  "A:e14" [label="HARD_BRAKE_END\nA\nt=3.70", fillcolor="#fde68a"];
  "A:e15" [label="CLOSING_END\nA -> track_001\nt=4.05", fillcolor="#bfdbfe"];
  "A:e16" [label="BRAKE_END\nA\nt=4.10", fillcolor="#fde68a"];
  "A:e17" [label="CUT_IN_FROM_LEFT_END\nA -> track_001\nt=5.30", fillcolor="#bfdbfe"];
  {rank=same; "A:e01"; "A:e02"; "A:e03";}
  {rank=same; "A:e09"; "A:e10";}

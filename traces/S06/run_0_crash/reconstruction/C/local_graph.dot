  "C:e16" [label="STOP_START\nC\nt=2.90", fillcolor="#e5e7eb"];
  "C:e17" [label="EGO_PATH_EXIT\nC -> track_002\nt=3.65", fillcolor="#bfdbfe"];
  "C:e18" [label="CLOSING_END\nC -> track_003\nt=4.60", fillcolor="#bfdbfe"];
  "C:e19" [label="EGO_PATH_ENTRY\nC -> track_003\nt=4.60", fillcolor="#bfdbfe"];
  "C:e20" [label="TRACK_LOST\nC -> track_002\nt=4.60", fillcolor="#bfdbfe"];

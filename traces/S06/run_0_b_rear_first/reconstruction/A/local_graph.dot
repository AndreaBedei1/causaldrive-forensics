  "A:e15" [label="MOVING_END\nA\nt=6.20", fillcolor="#e5e7eb"];
  "A:e16" [label="STOP_START\nA\nt=6.20", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02";}
  {rank=same; "A:e04"; "A:e05";}
  {rank=same; "A:e11"; "A:e12"; "A:e13";}
  {rank=same; "A:e15"; "A:e16";}

  "A:e12" [label="CRITICAL_TTC_END\nA -> track_002\nt=6.00", fillcolor="#bfdbfe"];
  "A:e13" [label="CLOSING_END\nA -> track_002\nt=6.00", fillcolor="#bfdbfe"];

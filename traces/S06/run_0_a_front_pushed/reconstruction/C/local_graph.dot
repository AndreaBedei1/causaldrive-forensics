digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="STRONG_THROTTLE_START\nC\nt=0.50", fillcolor="#fde68a"];
  "C:e03" [label="STRONG_THROTTLE_END\nC\nt=2.05", fillcolor="#fde68a"];
  "C:e04" [label="SPEED_LIMIT_EXCEEDED_START\nC\nt=2.40", fillcolor="#e5e7eb"];
  "C:e05" [label="BRAKE_START\nC\nt=2.95", fillcolor="#fde68a"];
  "C:e06" [label="HARD_BRAKE_START\nC\nt=2.95", fillcolor="#fde68a"];
  "C:e07" [label="SPEED_LIMIT_EXCEEDED_END\nC\nt=3.05", fillcolor="#e5e7eb"];
  "C:e08" [label="MOVING_END\nC\nt=4.05", fillcolor="#e5e7eb"];
  "C:e09" [label="STOP_START\nC\nt=4.05", fillcolor="#e5e7eb"];
  "C:e10" [label="COLLISION\nC\nt=6.15", fillcolor="#fca5a5"];
  {rank=same; "C:e05"; "C:e06";}
  {rank=same; "C:e08"; "C:e09";}
  "C:e01" -> "C:e02" [label="PRECEDES"];
  "C:e02" -> "C:e03" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e04" -> "C:e05" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e09" [label="PRECEDES"];
  "C:e08" -> "C:e10" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
}

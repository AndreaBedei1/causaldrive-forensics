digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="BRAKE_START\nB\nt=1.95", fillcolor="#fde68a"];
  "B:e03" [label="STOP_SIGN_DETECTED_START\nB -> sign-1\nt=2.10", fillcolor="#bfdbfe"];
  "B:e04" [label="STOP_SIGN_DETECTED_END\nB -> sign-1\nt=2.50", fillcolor="#bfdbfe"];
  "B:e05" [label="TRACK_APPEARED_LEFT\nB -> track_001\nt=2.60", fillcolor="#bfdbfe"];
  "B:e06" [label="CLOSING_START\nB -> track_001\nt=2.60", fillcolor="#bfdbfe"];
  "B:e07" [label="BRAKE_END\nB\nt=2.65", fillcolor="#fde68a"];
  "B:e08" [label="TURN_LEFT_START\nB\nt=3.80", fillcolor="#e5e7eb"];
  "B:e09" [label="CRITICAL_TTC_START\nB -> track_001\nt=4.10", fillcolor="#bfdbfe"];
  "B:e10" [label="EGO_PATH_ENTRY\nB -> track_001\nt=5.35", fillcolor="#bfdbfe"];
  "B:e11" [label="COLLISION\nB\nt=5.50", fillcolor="#fca5a5"];
  "B:e12" [label="TURN_LEFT_END\nB\nt=5.50", fillcolor="#e5e7eb"];
  "B:e13" [label="BRAKE_START\nB\nt=5.55", fillcolor="#fde68a"];
  "B:e14" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.70", fillcolor="#bfdbfe"];
  "B:e15" [label="CLOSING_END\nB -> track_001\nt=5.70", fillcolor="#bfdbfe"];
  "B:e16" [label="MOVING_END\nB\nt=5.70", fillcolor="#e5e7eb"];
  "B:e17" [label="STOP_START\nB\nt=5.70", fillcolor="#e5e7eb"];
  {rank=same; "B:e05"; "B:e06";}
  {rank=same; "B:e11"; "B:e12";}
  {rank=same; "B:e14"; "B:e15"; "B:e16"; "B:e17";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e07" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e08" -> "B:e09" [label="PRECEDES"];
  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e10" -> "B:e11" [label="PRECEDES"];
  "B:e10" -> "B:e12" [label="PRECEDES"];
  "B:e11" -> "B:e13" [label="PRECEDES"];
  "B:e12" -> "B:e13" [label="PRECEDES"];
  "B:e13" -> "B:e14" [label="PRECEDES"];
  "B:e13" -> "B:e15" [label="PRECEDES"];
  "B:e13" -> "B:e16" [label="PRECEDES"];
  "B:e13" -> "B:e17" [label="PRECEDES"];

digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="STRONG_THROTTLE_START\nB\nt=1.25", fillcolor="#fde68a"];
  "B:e03" [label="STRONG_THROTTLE_END\nB\nt=1.85", fillcolor="#fde68a"];
  "B:e04" [label="STOP_SIGN_DETECTED_START\nB -> sign-1\nt=2.10", fillcolor="#bfdbfe"];
  "B:e05" [label="STOP_SIGN_DETECTED_END\nB -> sign-1\nt=2.35", fillcolor="#bfdbfe"];
  "B:e06" [label="BRAKE_START\nB\nt=2.55", fillcolor="#fde68a"];
  "B:e07" [label="HARD_BRAKE_START\nB\nt=2.55", fillcolor="#fde68a"];
  "B:e08" [label="MOVING_END\nB\nt=3.25", fillcolor="#e5e7eb"];
  "B:e09" [label="STOP_START\nB\nt=3.25", fillcolor="#e5e7eb"];
  "B:e10" [label="TRACK_APPEARED_LEFT\nB -> track_001\nt=3.50", fillcolor="#bfdbfe"];
  "B:e11" [label="CLOSING_START\nB -> track_001\nt=3.50", fillcolor="#bfdbfe"];
  "B:e12" [label="CRITICAL_TTC_START\nB -> track_001\nt=4.40", fillcolor="#bfdbfe"];
  "B:e13" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.75", fillcolor="#bfdbfe"];
  "B:e14" [label="EGO_PATH_ENTRY\nB -> track_001\nt=5.80", fillcolor="#bfdbfe"];
  "B:e15" [label="CLOSING_END\nB -> track_001\nt=6.10", fillcolor="#bfdbfe"];
  "B:e16" [label="EGO_PATH_EXIT\nB -> track_001\nt=6.20", fillcolor="#bfdbfe"];
  "B:e17" [label="TRACK_LOST\nB -> track_001\nt=7.30", fillcolor="#bfdbfe"];
  "B:e18" [label="STRONG_THROTTLE_START\nB\nt=9.55", fillcolor="#fde68a"];
  {rank=same; "B:e06"; "B:e07";}
  {rank=same; "B:e08"; "B:e09";}
  {rank=same; "B:e10"; "B:e11";}

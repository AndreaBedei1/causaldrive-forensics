  "B:e03" [label="STRONG_THROTTLE_END\nB\nt=1.80", fillcolor="#fde68a"];
  "B:e04" [label="TRACK_APPEARED\nB -> track_001\nt=2.65", fillcolor="#bfdbfe"];

  "B:e12" [label="HARD_BRAKE_START\nB\nt=5.30", fillcolor="#fde68a"];
  "B:e13" [label="MOVING_END\nB\nt=5.35", fillcolor="#e5e7eb"];
  "B:e14" [label="STOP_START\nB\nt=5.35", fillcolor="#e5e7eb"];
  "B:e15" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.40", fillcolor="#bfdbfe"];
  "B:e16" [label="CLOSING_END\nB -> track_001\nt=5.40", fillcolor="#bfdbfe"];
  {rank=same; "B:e04"; "B:e05";}
  {rank=same; "B:e08"; "B:e09";}
  {rank=same; "B:e10"; "B:e11"; "B:e12";}
  {rank=same; "B:e13"; "B:e14";}
  {rank=same; "B:e15"; "B:e16";}

digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="TRACK_APPEARED_RIGHT\nB -> track_001\nt=2.70", fillcolor="#bfdbfe"];
  "B:e03" [label="CLOSING_START\nB -> track_001\nt=2.70", fillcolor="#bfdbfe"];
  "B:e04" [label="CRITICAL_TTC_START\nB -> track_001\nt=3.55", fillcolor="#bfdbfe"];
  "B:e05" [label="EGO_PATH_ENTRY\nB -> track_001\nt=4.95", fillcolor="#bfdbfe"];
  "B:e06" [label="COLLISION\nB\nt=5.25", fillcolor="#fca5a5"];
  "B:e07" [label="BRAKE_START\nB\nt=5.30", fillcolor="#fde68a"];
  "B:e08" [label="MOVING_END\nB\nt=5.35", fillcolor="#e5e7eb"];
  "B:e09" [label="STOP_START\nB\nt=5.35", fillcolor="#e5e7eb"];
  "B:e10" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.40", fillcolor="#bfdbfe"];
  "B:e11" [label="CLOSING_END\nB -> track_001\nt=5.40", fillcolor="#bfdbfe"];
  {rank=same; "B:e02"; "B:e03";}
  {rank=same; "B:e08"; "B:e09";}
  {rank=same; "B:e10"; "B:e11";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e07" -> "B:e09" [label="PRECEDES"];
  "B:e08" -> "B:e10" [label="PRECEDES"];
  "B:e08" -> "B:e11" [label="PRECEDES"];
  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e09" -> "B:e11" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="STOP_SIGN_DETECTED_START\nA -> sign-0\nt=1.85", fillcolor="#bfdbfe"];
  "A:e03" [label="BRAKE_START\nA\nt=1.95", fillcolor="#fde68a"];
  "A:e04" [label="HARD_BRAKE_START\nA\nt=1.95", fillcolor="#fde68a"];
  "A:e05" [label="STOP_SIGN_DETECTED_END\nA -> sign-0\nt=2.15", fillcolor="#bfdbfe"];
  "A:e06" [label="HARD_BRAKE_END\nA\nt=2.20", fillcolor="#fde68a"];
  "A:e07" [label="BRAKE_END\nA\nt=3.80", fillcolor="#fde68a"];
  "A:e08" [label="TRACK_APPEARED\nA -> track_001\nt=3.80", fillcolor="#bfdbfe"];
  "A:e09" [label="CLOSING_START\nA -> track_001\nt=3.80", fillcolor="#bfdbfe"];
  "A:e10" [label="CRITICAL_TTC_START\nA -> track_001\nt=3.80", fillcolor="#bfdbfe"];
  "A:e11" [label="PREDICTED_PATH_CONFLICT_START\nA -> track_001\nt=4.70", fillcolor="#bfdbfe"];
  "A:e12" [label="EGO_PATH_ENTRY\nA -> track_001\nt=5.20", fillcolor="#bfdbfe"];
  "A:e13" [label="TRACK_LOST\nA -> track_001\nt=5.20", fillcolor="#bfdbfe"];
  "A:e14" [label="COLLISION\nA\nt=5.25", fillcolor="#fca5a5"];
  "A:e15" [label="STRONG_THROTTLE_START\nA\nt=5.25", fillcolor="#fde68a"];
  "A:e16" [label="STRONG_THROTTLE_END\nA\nt=5.30", fillcolor="#fde68a"];
  "A:e17" [label="BRAKE_START\nA\nt=5.30", fillcolor="#fde68a"];
  "A:e18" [label="HARD_BRAKE_START\nA\nt=5.30", fillcolor="#fde68a"];
  "A:e19" [label="MOVING_END\nA\nt=5.40", fillcolor="#e5e7eb"];
  "A:e20" [label="STOP_START\nA\nt=5.40", fillcolor="#e5e7eb"];
  {rank=same; "A:e03"; "A:e04";}
  {rank=same; "A:e07"; "A:e08"; "A:e09"; "A:e10";}
  {rank=same; "A:e12"; "A:e13";}
  {rank=same; "A:e14"; "A:e15";}
  {rank=same; "A:e16"; "A:e17"; "A:e18";}
  {rank=same; "A:e19"; "A:e20";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e02" -> "A:e04" [label="PRECEDES"];
  "A:e03" -> "A:e05" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];

digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="STOP_SIGN_DETECTED_START\nA -> sign-0\nt=1.85", fillcolor="#bfdbfe"];
  "A:e03" [label="BRAKE_START\nA\nt=1.95", fillcolor="#fde68a"];
  "A:e04" [label="STOP_SIGN_DETECTED_END\nA -> sign-0\nt=2.15", fillcolor="#bfdbfe"];
  "A:e05" [label="TURN_LEFT_START\nA\nt=2.70", fillcolor="#e5e7eb"];
  "A:e06" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=2.75", fillcolor="#bfdbfe"];
  "A:e07" [label="CLOSING_START\nA -> track_001\nt=2.75", fillcolor="#bfdbfe"];
  "A:e08" [label="BRAKE_END\nA\nt=3.80", fillcolor="#fde68a"];
  "A:e09" [label="CRITICAL_TTC_START\nA -> track_001\nt=3.80", fillcolor="#bfdbfe"];
  "A:e10" [label="TRACK_LOST\nA -> track_001\nt=5.20", fillcolor="#bfdbfe"];
  "A:e11" [label="COLLISION\nA\nt=5.25", fillcolor="#fca5a5"];
  "A:e12" [label="TURN_LEFT_END\nA\nt=5.30", fillcolor="#e5e7eb"];
  "A:e13" [label="BRAKE_START\nA\nt=5.30", fillcolor="#fde68a"];
  "A:e14" [label="MOVING_END\nA\nt=5.40", fillcolor="#e5e7eb"];
  "A:e15" [label="STOP_START\nA\nt=5.40", fillcolor="#e5e7eb"];
  {rank=same; "A:e06"; "A:e07";}
  {rank=same; "A:e08"; "A:e09";}
  {rank=same; "A:e12"; "A:e13";}
  {rank=same; "A:e14"; "A:e15";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e05" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
  "A:e06" -> "A:e09" [label="PRECEDES"];
  "A:e07" -> "A:e08" [label="PRECEDES"];
  "A:e07" -> "A:e09" [label="PRECEDES"];
  "A:e08" -> "A:e10" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e11" -> "A:e12" [label="PRECEDES"];
  "A:e11" -> "A:e13" [label="PRECEDES"];
  "A:e12" -> "A:e14" [label="PRECEDES"];
  "A:e12" -> "A:e15" [label="PRECEDES"];
  "A:e13" -> "A:e14" [label="PRECEDES"];
  "A:e13" -> "A:e15" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e06" -> "A:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e06" -> "A:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

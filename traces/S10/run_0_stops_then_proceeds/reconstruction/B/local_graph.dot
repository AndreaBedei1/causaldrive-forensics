digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="STRONG_THROTTLE_START\nB\nt=1.20", fillcolor="#fde68a"];
  "B:e03" [label="STRONG_THROTTLE_END\nB\nt=1.80", fillcolor="#fde68a"];
  "B:e04" [label="TRACK_APPEARED\nB -> track_001\nt=2.55", fillcolor="#bfdbfe"];
  "B:e05" [label="CLOSING_START\nB -> track_001\nt=2.55", fillcolor="#bfdbfe"];
  "B:e06" [label="CRITICAL_TTC_START\nB -> track_001\nt=4.30", fillcolor="#bfdbfe"];
  "B:e07" [label="TRACK_LOST\nB -> track_001\nt=5.50", fillcolor="#bfdbfe"];
  "B:e08" [label="STOP_SIGN_DETECTED_START\nB -> sign-1\nt=7.60", fillcolor="#bfdbfe"];
  "B:e09" [label="STOP_SIGN_DETECTED_END\nB -> sign-1\nt=7.70", fillcolor="#bfdbfe"];
  {rank=same; "B:e04"; "B:e05";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e08" -> "B:e09" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e04" -> "B:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e04" -> "B:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

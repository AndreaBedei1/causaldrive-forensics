digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="STOP_SIGN_DETECTED_START\nA -> sign-0\nt=1.90", fillcolor="#bfdbfe"];
  "A:e03" [label="STOP_SIGN_DETECTED_END\nA -> sign-0\nt=2.15", fillcolor="#bfdbfe"];
  "A:e04" [label="BRAKE_START\nA\nt=2.55", fillcolor="#fde68a"];
  "A:e05" [label="HARD_BRAKE_START\nA\nt=2.55", fillcolor="#fde68a"];
  "A:e06" [label="MOVING_END\nA\nt=3.35", fillcolor="#e5e7eb"];
  "A:e07" [label="STOP_START\nA\nt=3.35", fillcolor="#e5e7eb"];
  "A:e08" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=3.70", fillcolor="#bfdbfe"];
  "A:e09" [label="CLOSING_START\nA -> track_001\nt=3.70", fillcolor="#bfdbfe"];
  "A:e10" [label="CRITICAL_TTC_START\nA -> track_001\nt=4.25", fillcolor="#bfdbfe"];
  "A:e11" [label="EGO_PATH_ENTRY\nA -> track_001\nt=5.80", fillcolor="#bfdbfe"];
  "A:e12" [label="CRITICAL_TTC_END\nA -> track_001\nt=5.95", fillcolor="#bfdbfe"];
  "A:e13" [label="CLOSING_END\nA -> track_001\nt=6.10", fillcolor="#bfdbfe"];
  "A:e14" [label="EGO_PATH_EXIT\nA -> track_001\nt=6.25", fillcolor="#bfdbfe"];
  "A:e15" [label="TRACK_LOST\nA -> track_001\nt=7.00", fillcolor="#bfdbfe"];
  "A:e16" [label="STRONG_THROTTLE_START\nA\nt=9.55", fillcolor="#fde68a"];
  {rank=same; "A:e04"; "A:e05";}
  {rank=same; "A:e06"; "A:e07";}
  {rank=same; "A:e08"; "A:e09";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e03" -> "A:e05" [label="PRECEDES"];

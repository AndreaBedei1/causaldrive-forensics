digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="STOP_SIGN_DETECTED_START\nA -> sign-0\nt=1.85", fillcolor="#bfdbfe"];
  "A:e03" [label="STOP_SIGN_DETECTED_END\nA -> sign-0\nt=2.15", fillcolor="#bfdbfe"];
  "A:e04" [label="BRAKE_START\nA\nt=2.55", fillcolor="#fde68a"];
  "A:e05" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=2.65", fillcolor="#bfdbfe"];
  "A:e06" [label="CLOSING_START\nA -> track_001\nt=2.65", fillcolor="#bfdbfe"];
  "A:e07" [label="MOVING_END\nA\nt=3.35", fillcolor="#e5e7eb"];
  "A:e08" [label="STOP_START\nA\nt=3.35", fillcolor="#e5e7eb"];
  "A:e09" [label="EGO_PATH_ENTRY\nA -> track_001\nt=5.80", fillcolor="#bfdbfe"];
  "A:e10" [label="CLOSING_END\nA -> track_001\nt=6.15", fillcolor="#bfdbfe"];
  "A:e11" [label="EGO_PATH_EXIT\nA -> track_001\nt=6.25", fillcolor="#bfdbfe"];
  "A:e12" [label="TRACK_LOST\nA -> track_001\nt=9.45", fillcolor="#bfdbfe"];
  {rank=same; "A:e05"; "A:e06";}
  {rank=same; "A:e07"; "A:e08";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e04" -> "A:e06" [label="PRECEDES"];
  "A:e05" -> "A:e07" [label="PRECEDES"];
  "A:e05" -> "A:e08" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
  "A:e07" -> "A:e09" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e11" -> "A:e12" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e05" -> "A:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e05" -> "A:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e05" -> "A:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e05" -> "A:e12" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="TRACK_APPEARED_RIGHT\nB -> track_001\nt=2.60", fillcolor="#bfdbfe"];
  "B:e03" [label="CLOSING_START\nB -> track_001\nt=2.60", fillcolor="#bfdbfe"];
  "B:e04" [label="CRITICAL_TTC_START\nB -> track_001\nt=4.25", fillcolor="#bfdbfe"];
  "B:e05" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.95", fillcolor="#bfdbfe"];
  "B:e06" [label="CLOSING_END\nB -> track_001\nt=6.15", fillcolor="#bfdbfe"];
  "B:e07" [label="STOP_SIGN_DETECTED_START\nB -> sign-0\nt=7.60", fillcolor="#bfdbfe"];
  "B:e08" [label="STOP_SIGN_DETECTED_END\nB -> sign-0\nt=7.80", fillcolor="#bfdbfe"];
  {rank=same; "B:e02"; "B:e03";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

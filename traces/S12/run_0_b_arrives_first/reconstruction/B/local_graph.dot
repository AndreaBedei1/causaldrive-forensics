digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="STOP_SIGN_DETECTED_START\nB -> sign-0\nt=1.80", fillcolor="#bfdbfe"];
  "B:e03" [label="STOP_SIGN_DETECTED_END\nB -> sign-0\nt=2.60", fillcolor="#bfdbfe"];
  "B:e04" [label="BRAKE_START\nB\nt=2.65", fillcolor="#fde68a"];
  "B:e05" [label="TRACK_APPEARED_RIGHT\nB -> track_001\nt=3.05", fillcolor="#bfdbfe"];
  "B:e06" [label="CLOSING_START\nB -> track_001\nt=3.05", fillcolor="#bfdbfe"];
  "B:e07" [label="MOVING_END\nB\nt=3.40", fillcolor="#e5e7eb"];
  "B:e08" [label="STOP_START\nB\nt=3.40", fillcolor="#e5e7eb"];
  "B:e09" [label="CLOSING_END\nB -> track_001\nt=4.70", fillcolor="#bfdbfe"];
  "B:e10" [label="BRAKE_END\nB\nt=6.45", fillcolor="#fde68a"];
  "B:e11" [label="STOP_END\nB\nt=6.85", fillcolor="#e5e7eb"];
  "B:e12" [label="MOVING_START\nB\nt=6.85", fillcolor="#e5e7eb"];
  "B:e13" [label="CLOSING_START\nB -> track_001\nt=7.00", fillcolor="#bfdbfe"];
  "B:e14" [label="TRACK_LOST\nB -> track_001\nt=9.45", fillcolor="#bfdbfe"];
  {rank=same; "B:e05"; "B:e06";}
  {rank=same; "B:e07"; "B:e08";}
  {rank=same; "B:e11"; "B:e12";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e07" [label="PRECEDES"];

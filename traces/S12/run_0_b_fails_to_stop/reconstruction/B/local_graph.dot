  "B:e12" [label="MOVING_END\nB\nt=10.05", fillcolor="#e5e7eb"];
  "B:e13" [label="STOP_START\nB\nt=10.05", fillcolor="#e5e7eb"];
  "B:e14" [label="CLOSING_END\nB -> track_001\nt=10.15", fillcolor="#bfdbfe"];
  "B:e15" [label="EGO_PATH_ENTRY\nB -> track_001\nt=10.15", fillcolor="#bfdbfe"];
  {rank=same; "B:e06"; "B:e07";}
  {rank=same; "B:e11"; "B:e12"; "B:e13";}
  {rank=same; "B:e14"; "B:e15";}
  "B:e01" -> "B:e02" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];

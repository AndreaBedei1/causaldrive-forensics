  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e10" -> "B:e11" [label="PRECEDES"];
  "B:e10" -> "B:e12" [label="PRECEDES"];
  "B:e10" -> "B:e13" [label="PRECEDES"];
  "B:e11" -> "B:e14" [label="PRECEDES"];
  "B:e11" -> "B:e15" [label="PRECEDES"];
  "B:e12" -> "B:e14" [label="PRECEDES"];
  "B:e12" -> "B:e15" [label="PRECEDES"];
  "B:e13" -> "B:e14" [label="PRECEDES"];

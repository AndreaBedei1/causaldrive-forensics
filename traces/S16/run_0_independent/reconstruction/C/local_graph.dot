  "C:e16" [label="STOP_SIGN_DETECTED_END\nC -> sign-3\nt=13.60", fillcolor="#bfdbfe"];
  "C:e17" [label="TRACK_LOST\nC -> track_001\nt=14.05", fillcolor="#bfdbfe"];

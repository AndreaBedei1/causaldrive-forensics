digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="MOVING_END\nC\nt=0.30", fillcolor="#e5e7eb"];
  "C:e03" [label="STOP_START\nC\nt=0.30", fillcolor="#e5e7eb"];
  "C:e04" [label="COLLISION\nC\nt=5.90", fillcolor="#fca5a5"];
  "C:e05" [label="STOP_END\nC\nt=5.90", fillcolor="#e5e7eb"];
  "C:e06" [label="MOVING_START\nC\nt=5.90", fillcolor="#e5e7eb"];
  "C:e07" [label="BRAKE_START\nC\nt=5.95", fillcolor="#fde68a"];
  "C:e08" [label="MOVING_END\nC\nt=6.05", fillcolor="#e5e7eb"];
  "C:e09" [label="STOP_START\nC\nt=6.05", fillcolor="#e5e7eb"];
  {rank=same; "C:e02"; "C:e03";}
  {rank=same; "C:e04"; "C:e05"; "C:e06";}
  {rank=same; "C:e08"; "C:e09";}
  "C:e01" -> "C:e02" [label="PRECEDES"];
  "C:e01" -> "C:e03" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="PRECEDES"];
  "C:e02" -> "C:e05" [label="PRECEDES"];
  "C:e02" -> "C:e06" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e03" -> "C:e05" [label="PRECEDES"];
  "C:e03" -> "C:e06" [label="PRECEDES"];
  "C:e04" -> "C:e07" [label="PRECEDES"];
  "C:e05" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e09" [label="PRECEDES"];
}

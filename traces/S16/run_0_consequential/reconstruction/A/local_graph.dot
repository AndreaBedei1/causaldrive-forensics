digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TRACK_APPEARED_REAR\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e03" [label="CLOSING_START\nA -> track_001\nt=0.70", fillcolor="#bfdbfe"];
  "A:e04" [label="CLOSING_END\nA -> track_001\nt=1.40", fillcolor="#bfdbfe"];
  "A:e05" [label="BRAKE_START\nA\nt=3.95", fillcolor="#fde68a"];
  "A:e06" [label="CLOSING_START\nA -> track_001\nt=4.20", fillcolor="#bfdbfe"];
  "A:e07" [label="COLLISION\nA\nt=5.15", fillcolor="#fca5a5"];
  "A:e08" [label="CLOSING_END\nA -> track_001\nt=5.15", fillcolor="#bfdbfe"];
  "A:e09" [label="BRAKE_END\nA\nt=5.20", fillcolor="#fde68a"];
  "A:e10" [label="TURN_LEFT_START\nA\nt=5.40", fillcolor="#e5e7eb"];
  "A:e11" [label="COLLISION\nA\nt=5.90", fillcolor="#fca5a5"];
  "A:e12" [label="TURN_LEFT_END\nA\nt=6.00", fillcolor="#e5e7eb"];
  "A:e13" [label="MOVING_END\nA\nt=6.05", fillcolor="#e5e7eb"];
  "A:e14" [label="STOP_START\nA\nt=6.05", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02";}
  {rank=same; "A:e07"; "A:e08";}
  {rank=same; "A:e13"; "A:e14";}
  "A:e01" -> "A:e03" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
  "A:e07" -> "A:e09" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e11" -> "A:e12" [label="PRECEDES"];
  "A:e12" -> "A:e13" [label="PRECEDES"];
  "A:e12" -> "A:e14" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

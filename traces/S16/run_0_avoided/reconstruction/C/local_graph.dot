digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED_REAR\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e03" [label="CLOSING_START\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e04" [label="TRACK_APPEARED_REAR\nC -> track_002\nt=0.15", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=0.15", fillcolor="#bfdbfe"];
  "C:e06" [label="MOVING_END\nC\nt=0.30", fillcolor="#e5e7eb"];
  "C:e07" [label="STOP_START\nC\nt=0.30", fillcolor="#e5e7eb"];
  "C:e08" [label="TRACK_LOST\nC -> track_001\nt=5.15", fillcolor="#bfdbfe"];
  "C:e09" [label="CLOSING_END\nC -> track_002\nt=5.60", fillcolor="#bfdbfe"];
  {rank=same; "C:e01"; "C:e02"; "C:e03";}
  {rank=same; "C:e04"; "C:e05";}
  {rank=same; "C:e06"; "C:e07";}
  "C:e01" -> "C:e04" [label="PRECEDES"];
  "C:e01" -> "C:e05" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="PRECEDES"];
  "C:e02" -> "C:e05" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e03" -> "C:e05" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e04" -> "C:e07" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e08" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e02" -> "C:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e04" -> "C:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

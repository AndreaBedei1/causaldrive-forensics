digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="STRONG_THROTTLE_START\nA\nt=0.70", fillcolor="#fde68a"];
  "A:e03" [label="STRONG_THROTTLE_END\nA\nt=1.80", fillcolor="#fde68a"];
  "A:e04" [label="BRAKE_START\nA\nt=3.95", fillcolor="#fde68a"];
  "A:e05" [label="COLLISION\nA\nt=5.15", fillcolor="#fca5a5"];
  "A:e06" [label="HARD_BRAKE_START\nA\nt=5.20", fillcolor="#fde68a"];
  "A:e07" [label="MOVING_END\nA\nt=5.75", fillcolor="#e5e7eb"];
  "A:e08" [label="STOP_START\nA\nt=5.75", fillcolor="#e5e7eb"];
  {rank=same; "A:e07"; "A:e08";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
}

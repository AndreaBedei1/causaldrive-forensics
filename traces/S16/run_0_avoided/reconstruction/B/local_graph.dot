  "B:e10" [label="COLLISION\nB\nt=5.15", fillcolor="#fca5a5"];
  "B:e11" [label="CRITICAL_TTC_END\nB -> track_001\nt=5.20", fillcolor="#bfdbfe"];
  "B:e12" [label="CLOSING_END\nB -> track_001\nt=5.20", fillcolor="#bfdbfe"];
  "B:e13" [label="MOVING_END\nB\nt=5.60", fillcolor="#e5e7eb"];
  "B:e14" [label="STOP_START\nB\nt=5.60", fillcolor="#e5e7eb"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e05"; "B:e06";}
  {rank=same; "B:e11"; "B:e12";}
  {rank=same; "B:e13"; "B:e14";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];

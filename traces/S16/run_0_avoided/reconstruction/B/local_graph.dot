  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e08" -> "B:e09" [label="PRECEDES"];
  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e10" -> "B:e11" [label="PRECEDES"];
  "B:e10" -> "B:e12" [label="PRECEDES"];
  "B:e11" -> "B:e13" [label="PRECEDES"];
  "B:e11" -> "B:e14" [label="PRECEDES"];
  "B:e12" -> "B:e13" [label="PRECEDES"];
  "B:e12" -> "B:e14" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];

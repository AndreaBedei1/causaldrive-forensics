  "A:e16" [label="MOVING_END\nA\nt=5.85", fillcolor="#e5e7eb"];
  "A:e17" [label="STOP_START\nA\nt=5.85", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02";}
  {rank=same; "A:e09"; "A:e10"; "A:e11"; "A:e12";}
  {rank=same; "A:e13"; "A:e14"; "A:e15";}
  {rank=same; "A:e16"; "A:e17";}

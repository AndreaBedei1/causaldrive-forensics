digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TRACK_APPEARED_FRONT\nA -> track_001\nt=0.05", fillcolor="#bfdbfe"];
  "A:e03" [label="CLOSING_START\nA -> track_001\nt=0.45", fillcolor="#bfdbfe"];
  "A:e04" [label="CLOSING_END\nA -> track_001\nt=1.60", fillcolor="#bfdbfe"];
  "A:e05" [label="CLOSING_START\nA -> track_001\nt=3.90", fillcolor="#bfdbfe"];
  "A:e06" [label="CRITICAL_TTC_START\nA -> track_001\nt=4.60", fillcolor="#bfdbfe"];
  "A:e07" [label="COLLISION\nA\nt=5.70", fillcolor="#fca5a5"];
  "A:e08" [label="CRITICAL_TTC_END\nA -> track_001\nt=5.70", fillcolor="#bfdbfe"];
  "A:e09" [label="CLOSING_END\nA -> track_001\nt=5.70", fillcolor="#bfdbfe"];
  "A:e10" [label="BRAKE_START\nA\nt=5.75", fillcolor="#fde68a"];
  "A:e11" [label="MOVING_END\nA\nt=5.85", fillcolor="#e5e7eb"];
  "A:e12" [label="STOP_START\nA\nt=5.85", fillcolor="#e5e7eb"];
  {rank=same; "A:e07"; "A:e08"; "A:e09";}
  {rank=same; "A:e11"; "A:e12";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
  "A:e06" -> "A:e09" [label="PRECEDES"];
  "A:e07" -> "A:e10" [label="PRECEDES"];
  "A:e08" -> "A:e10" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e10" -> "A:e12" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

  "B:e15" [label="COLLISION\nB\nt=5.70", fillcolor="#fca5a5"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e08"; "B:e09";}
  {rank=same; "B:e12"; "B:e13"; "B:e14";}
  "B:e01" -> "B:e03" [label="PRECEDES"];

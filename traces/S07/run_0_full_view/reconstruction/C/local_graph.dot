digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="TRACK_APPEARED_REAR\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e03" [label="TRACK_APPEARED_REAR\nC -> track_002\nt=0.00", fillcolor="#bfdbfe"];
  "C:e04" [label="CLOSING_START\nC -> track_001\nt=0.80", fillcolor="#bfdbfe"];
  "C:e05" [label="CLOSING_START\nC -> track_002\nt=1.05", fillcolor="#bfdbfe"];
  "C:e06" [label="CLOSING_END\nC -> track_001\nt=2.00", fillcolor="#bfdbfe"];
  "C:e07" [label="CLOSING_END\nC -> track_002\nt=2.10", fillcolor="#bfdbfe"];
  "C:e08" [label="SPEED_LIMIT_EXCEEDED_START\nC\nt=2.40", fillcolor="#e5e7eb"];
  "C:e09" [label="TRACK_LOST\nC -> track_001\nt=2.50", fillcolor="#bfdbfe"];
  "C:e10" [label="TRACK_LOST\nC -> track_002\nt=2.85", fillcolor="#bfdbfe"];
  "C:e11" [label="BRAKE_START\nC\nt=2.95", fillcolor="#fde68a"];
  "C:e12" [label="SPEED_LIMIT_EXCEEDED_END\nC\nt=3.10", fillcolor="#e5e7eb"];
  "C:e13" [label="MOVING_END\nC\nt=4.05", fillcolor="#e5e7eb"];
  "C:e14" [label="STOP_START\nC\nt=4.05", fillcolor="#e5e7eb"];
  "C:e15" [label="BRAKE_END\nC\nt=12.95", fillcolor="#fde68a"];
  "C:e16" [label="STOP_END\nC\nt=13.75", fillcolor="#e5e7eb"];
  "C:e17" [label="MOVING_START\nC\nt=13.75", fillcolor="#e5e7eb"];
  {rank=same; "C:e01"; "C:e02"; "C:e03";}
  {rank=same; "C:e13"; "C:e14";}
  {rank=same; "C:e16"; "C:e17";}
  "C:e01" -> "C:e04" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="PRECEDES"];
  "C:e04" -> "C:e05" [label="PRECEDES"];
  "C:e05" -> "C:e06" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e09" -> "C:e10" [label="PRECEDES"];
  "C:e10" -> "C:e11" [label="PRECEDES"];
  "C:e11" -> "C:e12" [label="PRECEDES"];
  "C:e12" -> "C:e13" [label="PRECEDES"];
  "C:e12" -> "C:e14" [label="PRECEDES"];
  "C:e13" -> "C:e15" [label="PRECEDES"];
  "C:e14" -> "C:e15" [label="PRECEDES"];
  "C:e15" -> "C:e16" [label="PRECEDES"];
  "C:e15" -> "C:e17" [label="PRECEDES"];
  "C:e02" -> "C:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e02" -> "C:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

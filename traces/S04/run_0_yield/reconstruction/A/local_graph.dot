digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TRACK_APPEARED\nA -> track_001\nt=2.10", fillcolor="#bfdbfe"];
  "A:e03" [label="CLOSING_START\nA -> track_001\nt=2.10", fillcolor="#bfdbfe"];
  "A:e04" [label="CRITICAL_TTC_START\nA -> track_001\nt=3.00", fillcolor="#bfdbfe"];
  "A:e05" [label="PREDICTED_PATH_CONFLICT_START\nA -> track_001\nt=3.45", fillcolor="#bfdbfe"];
  "A:e06" [label="PREDICTED_PATH_CONFLICT_END\nA -> track_001\nt=3.75", fillcolor="#bfdbfe"];
  "A:e07" [label="TRACK_LOST\nA -> track_001\nt=4.95", fillcolor="#bfdbfe"];
  "A:e08" [label="STOP_SIGN_DETECTED_START\nA -> sign-0\nt=8.15", fillcolor="#bfdbfe"];
  "A:e09" [label="STOP_SIGN_DETECTED_END\nA -> sign-0\nt=8.45", fillcolor="#bfdbfe"];
  "A:e10" [label="TRACK_APPEARED\nA -> track_002\nt=9.70", fillcolor="#bfdbfe"];
  "A:e11" [label="CLOSING_START\nA -> track_002\nt=9.70", fillcolor="#bfdbfe"];
  {rank=same; "A:e02"; "A:e03";}
  {rank=same; "A:e10"; "A:e11";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e01" -> "A:e03" [label="PRECEDES"];
  "A:e02" -> "A:e04" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e07" -> "A:e08" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e09" -> "A:e11" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e10" -> "A:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

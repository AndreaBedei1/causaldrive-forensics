  "B:e07" [label="TURN_RIGHT_END\nB\nt=9.95", fillcolor="#e5e7eb"];
  "B:e08" [label="COLLISION\nB\nt=10.25", fillcolor="#fca5a5"];
  "B:e09" [label="CRITICAL_TTC_END\nB -> track_001\nt=10.25", fillcolor="#bfdbfe"];
  "B:e10" [label="CLOSING_END\nB -> track_001\nt=10.25", fillcolor="#bfdbfe"];
  "B:e11" [label="THROTTLE_END\nB\nt=10.30", fillcolor="#fde68a"];
  "B:e12" [label="BRAKE_START\nB\nt=10.30", fillcolor="#fde68a"];
  "B:e13" [label="MOVING_END\nB\nt=11.00", fillcolor="#e5e7eb"];
  "B:e14" [label="STOP_START\nB\nt=11.00", fillcolor="#e5e7eb"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e03"; "B:e04";}
  {rank=same; "B:e08"; "B:e09"; "B:e10";}
  {rank=same; "B:e11"; "B:e12";}
  {rank=same; "B:e13"; "B:e14";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e01" -> "B:e04" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];

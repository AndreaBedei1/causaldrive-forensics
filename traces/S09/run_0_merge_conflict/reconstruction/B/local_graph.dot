  "B:e15" [label="MOVING_END\nB\nt=2.55", fillcolor="#e5e7eb"];
  "B:e16" [label="STOP_START\nB\nt=2.55", fillcolor="#e5e7eb"];
  {rank=same; "B:e01"; "B:e02"; "B:e03"; "B:e04"; "B:e05";}
  {rank=same; "B:e09"; "B:e10"; "B:e11";}
  {rank=same; "B:e12"; "B:e13";}
  {rank=same; "B:e15"; "B:e16";}

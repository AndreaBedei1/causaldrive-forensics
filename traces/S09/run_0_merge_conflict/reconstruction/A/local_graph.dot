digraph "local_A" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle A (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "A:e01" [label="MOVING_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e02" [label="TURN_LEFT_START\nA\nt=0.00", fillcolor="#e5e7eb"];
  "A:e03" [label="TRACK_APPEARED_RIGHT\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e04" [label="CLOSING_START\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e05" [label="CRITICAL_TTC_START\nA -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "A:e06" [label="CRITICAL_TTC_END\nA -> track_001\nt=1.65", fillcolor="#bfdbfe"];
  "A:e07" [label="COLLISION\nA\nt=1.80", fillcolor="#fca5a5"];
  "A:e08" [label="CLOSING_END\nA -> track_001\nt=1.80", fillcolor="#bfdbfe"];
  "A:e09" [label="BRAKE_START\nA\nt=1.85", fillcolor="#fde68a"];
  "A:e10" [label="TURN_LEFT_END\nA\nt=2.45", fillcolor="#e5e7eb"];
  "A:e11" [label="MOVING_END\nA\nt=2.50", fillcolor="#e5e7eb"];
  "A:e12" [label="STOP_START\nA\nt=2.50", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02"; "A:e03"; "A:e04"; "A:e05";}
  {rank=same; "A:e07"; "A:e08";}
  {rank=same; "A:e11"; "A:e12";}
  "A:e01" -> "A:e06" [label="PRECEDES"];
  "A:e02" -> "A:e06" [label="PRECEDES"];
  "A:e03" -> "A:e06" [label="PRECEDES"];
  "A:e04" -> "A:e06" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e06" -> "A:e08" [label="PRECEDES"];
  "A:e07" -> "A:e09" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e09" -> "A:e10" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e10" -> "A:e12" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e03" -> "A:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e03" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e03" -> "A:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

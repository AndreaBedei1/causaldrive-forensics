digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="TRACK_APPEARED_REAR\nB -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "B:e03" [label="CLOSING_START\nB -> track_001\nt=0.50", fillcolor="#bfdbfe"];
  "B:e04" [label="CLOSING_END\nB -> track_001\nt=1.65", fillcolor="#bfdbfe"];
  "B:e05" [label="BRAKE_START\nB\nt=3.95", fillcolor="#fde68a"];
  "B:e06" [label="CLOSING_START\nB -> track_001\nt=4.25", fillcolor="#bfdbfe"];
  "B:e07" [label="MOVING_END\nB\nt=5.15", fillcolor="#e5e7eb"];
  "B:e08" [label="STOP_START\nB\nt=5.15", fillcolor="#e5e7eb"];
  "B:e09" [label="CLOSING_END\nB -> track_001\nt=6.40", fillcolor="#bfdbfe"];
  "B:e10" [label="BRAKE_END\nB\nt=11.95", fillcolor="#fde68a"];
  "B:e11" [label="STOP_END\nB\nt=12.35", fillcolor="#e5e7eb"];
  "B:e12" [label="MOVING_START\nB\nt=12.35", fillcolor="#e5e7eb"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e07"; "B:e08";}
  {rank=same; "B:e11"; "B:e12";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e06" -> "B:e08" [label="PRECEDES"];
  "B:e07" -> "B:e09" [label="PRECEDES"];
  "B:e08" -> "B:e09" [label="PRECEDES"];
  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e10" -> "B:e11" [label="PRECEDES"];
  "B:e10" -> "B:e12" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e02" -> "B:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}

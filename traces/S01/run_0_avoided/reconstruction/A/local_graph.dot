  "A:e03" [label="CLOSING_START\nA -> track_001\nt=0.45", fillcolor="#bfdbfe"];
  "A:e04" [label="STRONG_THROTTLE_START\nA\nt=1.15", fillcolor="#fde68a"];
  "A:e05" [label="STRONG_THROTTLE_END\nA\nt=1.35", fillcolor="#fde68a"];
  "A:e06" [label="CLOSING_END\nA -> track_001\nt=1.60", fillcolor="#bfdbfe"];
  "A:e07" [label="CLOSING_START\nA -> track_001\nt=4.25", fillcolor="#bfdbfe"];
  "A:e08" [label="CRITICAL_TTC_START\nA -> track_001\nt=5.00", fillcolor="#bfdbfe"];
  "A:e09" [label="BRAKE_START\nA\nt=5.05", fillcolor="#fde68a"];
  "A:e10" [label="HARD_BRAKE_START\nA\nt=5.05", fillcolor="#fde68a"];
  "A:e11" [label="CRITICAL_TTC_END\nA -> track_001\nt=6.25", fillcolor="#bfdbfe"];
  "A:e12" [label="CLOSING_END\nA -> track_001\nt=6.35", fillcolor="#bfdbfe"];
  "A:e13" [label="MOVING_END\nA\nt=6.35", fillcolor="#e5e7eb"];
  "A:e14" [label="STOP_START\nA\nt=6.35", fillcolor="#e5e7eb"];
  "A:e15" [label="STRONG_THROTTLE_START\nA\nt=13.05", fillcolor="#fde68a"];
  {rank=same; "A:e09"; "A:e10";}
  {rank=same; "A:e12"; "A:e13"; "A:e14";}
  "A:e01" -> "A:e02" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="PRECEDES"];
  "A:e03" -> "A:e04" [label="PRECEDES"];
  "A:e04" -> "A:e05" [label="PRECEDES"];
  "A:e05" -> "A:e06" [label="PRECEDES"];
  "A:e06" -> "A:e07" [label="PRECEDES"];
  "A:e07" -> "A:e08" [label="PRECEDES"];
  "A:e08" -> "A:e09" [label="PRECEDES"];
  "A:e08" -> "A:e10" [label="PRECEDES"];
  "A:e09" -> "A:e11" [label="PRECEDES"];
  "A:e10" -> "A:e11" [label="PRECEDES"];
  "A:e11" -> "A:e12" [label="PRECEDES"];
  "A:e11" -> "A:e13" [label="PRECEDES"];
  "A:e11" -> "A:e14" [label="PRECEDES"];
  "A:e12" -> "A:e15" [label="PRECEDES"];
  "A:e13" -> "A:e15" [label="PRECEDES"];
  "A:e14" -> "A:e15" [label="PRECEDES"];
  "A:e02" -> "A:e03" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "A:e02" -> "A:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];

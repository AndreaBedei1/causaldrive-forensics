# Raw recordings are generated locally and are not source files.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
*.log
# Local secrets: never committed.
.env
# Raw recordings of the old scenario sweeps, kept locally, not part of the canonical set.
/sweeps/
# Robustness study: scratch copies of the perturbed runs (deleted after each job; results go to results/robustness/).
/robustness/
# Raw recordings of an abandoned highway stress study, kept locally, not part of the project.
/stress_recordings/
# Robustness campaigns: the raw job records are committed compressed (jobs.jsonl.gz); the controller's working files stay local.
/results/robustness/*/jobs.jsonl
/results/robustness/*/control/running/
/results/robustness/*/control/controller.stdout.txt
/results/robustness/*/control/controller.lock
/results/robustness/*/control/command
